    function triggerDualComparison() {
      const elA = document.getElementById('abTargetElementA');
      const elB = document.getElementById('abTargetElementB');
      if (!elA || !elB) return;

      const durationMs = STATE.duration / timeScale;

      // Reset
      elA.style.transition = 'none';
      elA.style.transform = 'scale(0.8) translateY(20px)';
      elB.style.transform = 'scale(0.8) translateY(20px)';

      setTimeout(() => {
        // Option A: CSS Cubic Bezier
        elA.style.transition = `transform ${durationMs}ms cubic-bezier(${STATE.p1.x}, ${STATE.p1.y}, ${STATE.p2.x}, ${STATE.p2.y})`;
        elA.style.transform = 'scale(1.1) translateY(-20px)';

        // Option B: Real Spring Oscillation Simulation
        simulateSpringElement(elB, {
          targetScale: 1.1,
          targetY: -20,
          stiffness: STATE.stiffness,
          damping: STATE.damping,
          mass: STATE.mass
        });

        playTone(850, 0.06, 'triangle');
      }, 50);
    }

    function simulateSpringElement(element, config) {
      let currentY = 20;
      let velY = 0;
      let currentScale = 0.8;
      let velScale = 0;
      const targetY = config.targetY;
      const targetScale = config.targetScale;
      const k = config.stiffness * 0.001;
      const d = 1 - (config.damping * 0.02);

      let frameCount = 0;
      function step() {
        // Force Hooke: F = -k * x
        const forceY = (targetY - currentY) * k;
        velY = (velY + forceY) * d;
        currentY += velY * timeScale;

        const forceScale = (targetScale - currentScale) * k;
        velScale = (velScale + forceScale) * d;
        currentScale += velScale * timeScale;

        element.style.transform = `scale(${currentScale}) translateY(${currentY}px)`;

        if ((Math.abs(targetY - currentY) > 0.05 || Math.abs(velY) > 0.05) && frameCount < 400) {
          frameCount++;
          requestAnimationFrame(step);
        } else {
          element.style.transform = `scale(${targetScale}) translateY(${targetY}px)`;
        }
      }
      step();
    }

