    function setupCanvasParticleRepel(canvas) {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const dots = [];
      const numDots = 45;

      for (let i = 0; i < numDots; i++) {
        dots.push({
          origX: Math.random() * canvas.width,
          origY: Math.random() * canvas.height,
          x: 0, y: 0,
          vx: 0, vy: 0
        });
        dots[i].x = dots[i].origX;
        dots[i].y = dots[i].origY;
      }

      let mouse = { x: -100, y: -100 };
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      canvas.addEventListener('mouseleave', () => { mouse.x = -100; mouse.y = -100; });

      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        dots.forEach(d => {
          // Repulsion from mouse
          const dx = mouse.x - d.x;
          const dy = mouse.y - d.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 60) {
            const angle = Math.atan2(dy, dx);
            d.vx -= Math.cos(angle) * 3;
            d.vy -= Math.sin(angle) * 3;
          }

          // Spring return to orig
          d.vx += (d.origX - d.x) * 0.05;
          d.vy += (d.origY - d.y) * 0.05;
          d.vx *= 0.88;
          d.vy *= 0.88;
          d.x += d.vx;
          d.y += d.vy;

          ctx.beginPath();
          ctx.arc(d.x, d.y, 3, 0, Math.PI * 2);
          ctx.fillStyle = '#6366f1';
          ctx.fill();
        });

        particleCanvasRaf = requestAnimationFrame(loop);
      }
      cancelAnimationFrame(particleCanvasRaf);
      loop();
    }
