    let frameTimes = [];
    let lastLoopTime = performance.now();

    function updateTelemetryLoop(now) {
      const delta = now - lastLoopTime;
      lastLoopTime = now;

      if (delta > 0) {
        const fps = 1000 / delta;
        frameTimes.push(fps);
        if (frameTimes.length > 30) frameTimes.shift();

        const avgFps = frameTimes.reduce((a, b) => a + b, 0) / frameTimes.length;
        const fpsEl = document.getElementById('fpsCounter');
        if (fpsEl && frameTimes.length % 5 === 0) {
          fpsEl.innerText = Math.min(120, avgFps).toFixed(1);
          if (avgFps < 45) fpsEl.className = 'font-display font-bold text-3xl text-amber-400';
          else fpsEl.className = 'font-display font-bold text-3xl text-emerald-400';
        }
      }
      requestAnimationFrame(updateTelemetryLoop);
    }
    requestAnimationFrame(updateTelemetryLoop);

