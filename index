    /* ======================================================== */
    /* 6. TIMELINE SCRUBBER & GLOBAL SPEED ENGINE               */
    /* ======================================================== */
    let scrubProgress = 0;

    function onTimelineScrub(val) {
      scrubProgress = val / 1000;
      document.getElementById('scrubberFillBar').style.width = `${scrubProgress * 100}%`;
      
      const totalMs = STATE.duration;
      const currentMs = Math.round(totalMs * scrubProgress);
      document.getElementById('timeCurrentDisplay').innerText = formatMsToTime(currentMs);
      document.getElementById('timeTotalDisplay').innerText = formatMsToTime(totalMs);

      // Apply scrub to active stage if it has a scrub hook
      const stageEl = document.getElementById('activeAnimationStage');
      const scrubbableEl = stageEl.querySelector('[data-scrubbable]');
      if (scrubbableEl) {
        scrubbableEl.style.transform = `rotate(${scrubProgress * 360}deg) scale(${0.8 + scrubProgress * 0.4})`;
      }
    }

    function formatMsToTime(ms) {
      const totalSec = ms / 1000;
      const mins = Math.floor(totalSec / 60);
      const secs = Math.floor(totalSec % 60);
      const centis = Math.floor((ms % 1000) / 10);
      return `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}.${String(centis).padStart(2,'0')}`;
    }

    function toggleGlobalPlay() {
      isPlaying = !isPlaying;
      const icon = document.getElementById('iconPlayPause');
      if (isPlaying) {
        icon.setAttribute('data-lucide', 'pause');
        icon.className = 'w-4 h-4 text-emerald-400';
      } else {
        icon.setAttribute('data-lucide', 'play');
        icon.className = 'w-4 h-4 text-amber-400';
      }
      lucide.createIcons();
    }

    function stepFrame(dir) {
      const scrubber = document.getElementById('timelineScrubber');
      let val = parseInt(scrubber.value, 10) + (dir * 50);
      val = Math.max(0, Math.min(1000, val));
      scrubber.value = val;
      onTimelineScrub(val);
      playTone(900 + dir * 100, 0.02);
    }

    function setTimeScale(scale) {
      timeScale = parseFloat(scale);
      playTone(700 + timeScale * 100, 0.04);
      triggerActiveAnimationAction();
    }

    function restartActiveMotion() {
      const scrubber = document.getElementById('timelineScrubber');
      scrubber.value = 0;
      onTimelineScrub(0);
      triggerActiveAnimationAction();
    }

