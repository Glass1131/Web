    function setupSpringTossPhysics(arena, box) {
      let isDragging = false;
      let startX, startY;
      let lastX, lastY;
      let vx = 0, vy = 0;
      let posX = 0, posY = 0;
      let tossAnimId = null;

      box.addEventListener('mousedown', (e) => {
        isDragging = true;
        cancelAnimationFrame(tossAnimId);
        startX = e.clientX - posX;
        startY = e.clientY - posY;
        lastX = e.clientX;
        lastY = e.clientY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        posX = e.clientX - startX;
        posY = e.clientY - startY;
        vx = e.clientX - lastX;
        vy = e.clientY - lastY;
        lastX = e.clientX;
        lastY = e.clientY;
        box.style.transform = `translate(${posX}px, ${posY}px)`;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;

        function simulate() {
          posX += vx;
          posY += vy;
          vx *= 0.94; // friction
          vy *= 0.94;

          // Wall bounds bounce
          const maxX = 110, maxY = 80;
          if (posX > maxX || posX < -maxX) {
            vx *= -0.7; // restitution bounce
            posX = Math.max(-maxX, Math.min(maxX, posX));
            playTone(800, 0.02);
          }
          if (posY > maxY || posY < -maxY) {
            vy *= -0.7;
            posY = Math.max(-maxY, Math.min(maxY, posY));
            playTone(800, 0.02);
          }

          box.style.transform = `translate(${posX}px, ${posY}px)`;

          if (Math.hypot(vx, vy) > 0.1) {
            tossAnimId = requestAnimationFrame(simulate);
          }
        }
        simulate();
      });
    }

