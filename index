    function triggerSmoothCounter() {
      if (counterRafId) cancelAnimationFrame(counterRafId);
      const valEl = document.getElementById('counterTargetVal');
      const barEl = document.getElementById('counterBar');
      if (!valEl) return;

      const start = STATE.startNum;
      const end = STATE.endNum;
      const duration = STATE.duration / timeScale;
      let startTime = null;

      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        const elapsed = timestamp - startTime;
        const progress = Math.min(elapsed / duration, 1);

        // Cubic-Bezier easing evaluation
        const eased = (progress === 1) ? 1 : 1 - Math.pow(2, -10 * progress);
        const current = start + (end - start) * eased;

        valEl.innerText = current.toLocaleString('ko-KR', {
          minimumFractionDigits: STATE.decimals,
          maximumFractionDigits: STATE.decimals
        });
        if (barEl) barEl.style.width = `${progress * 100}%`;

        if (progress < 1) {
          counterRafId = requestAnimationFrame(step);
        } else {
          valEl.innerText = end.toLocaleString('ko-KR');
        }
      }
      counterRafId = requestAnimationFrame(step);
    }

    function getExportSmoothCounter(fmt, s) {
      if (fmt === 'css') {
        return `/* CSS Counter 애니메이션은 @property Houdini로 지원됩니다 */
@property --num {
  syntax: '<integer>';
  initial-value: 1;
  inherits: false;
}
.counter-box {
