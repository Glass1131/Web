    function triggerFlipGrid() {
      const container = document.getElementById('flipGridBox');
      if (!container) return;

      const cards = Array.from(container.querySelectorAll('.flip-card'));
      // FIRST: Record initial bounding rects
      const firstRects = new Map();
      cards.forEach(card => {
        firstRects.set(card.getAttribute('data-flip-id'), card.getBoundingClientRect());
      });

      // Shuffling DOM
      flipItems.sort(() => Math.random() - 0.5);
      flipItems.forEach(id => {
        const el = container.querySelector(`[data-flip-id="${id}"]`);
        container.appendChild(el);
      });

      // LAST: Record new rects, INVERT & PLAY
      cards.forEach(card => {
        const id = card.getAttribute('data-flip-id');
        const first = firstRects.get(id);
        const last = card.getBoundingClientRect();

        const dx = first.left - last.left;
        const dy = first.top - last.top;

        // Invert
        card.style.transform = `translate(${dx}px, ${dy}px)`;
        card.style.transition = 'none';

        // Play
        requestAnimationFrame(() => {
          card.style.transition = `transform ${STATE.duration / timeScale}ms cubic-bezier(${STATE.p1.x}, ${STATE.p1.y}, ${STATE.p2.x}, ${STATE.p2.y})`;
