    /* ======================================================== */
    /* 9. INTERACTIVE BEZIER CANVAS LOGIC                       */
    /* ======================================================== */
    const bCanvas = document.getElementById('inspectorBezierCanvas');
    const bCtx = bCanvas.getContext('2d');
    let draggingHandle = null;

    function drawBezierInspectors() {
      if (!bCanvas) return;
      const w = bCanvas.width;
      const h = bCanvas.height;
      const pad = 40;
      const plotW = w - pad * 2;
      const plotH = h - pad * 2;

      function toX(v) { return pad + v * plotW; }
      function toY(v) { return pad + (1 - v) * plotH; }
      function normX(sx) { return Math.max(0, Math.min(1, (sx - pad) / plotW)); }
      function normY(sy) { return 1 - (sy - pad) / plotH; }

      bCtx.clearRect(0, 0, w, h);

      // Grid box
      bCtx.strokeStyle = 'rgba(255,255,255,0.08)';
      bCtx.lineWidth = 1;
      bCtx.strokeRect(pad, pad, plotW, plotH);

      // Diagonal
      bCtx.beginPath();
      bCtx.setLineDash([2, 3]);
      bCtx.strokeStyle = 'rgba(255,255,255,0.15)';
      bCtx.moveTo(toX(0), toY(0));
      bCtx.lineTo(toX(1), toY(1));
      bCtx.stroke();
      bCtx.setLineDash([]);

      // Control Lines
      bCtx.beginPath();
      bCtx.strokeStyle = 'rgba(99, 102, 241, 0.4)';
      bCtx.lineWidth = 1.5;
      bCtx.moveTo(toX(0), toY(0));
      bCtx.lineTo(toX(STATE.p1.x), toY(STATE.p1.y));
      bCtx.moveTo(toX(1), toY(1));
      bCtx.lineTo(toX(STATE.p2.x), toY(STATE.p2.y));
      bCtx.stroke();

      // Bezier Curve
      bCtx.beginPath();
      bCtx.strokeStyle = '#6366f1';
      bCtx.lineWidth = 3;
      bCtx.moveTo(toX(0), toY(0));
      bCtx.bezierCurveTo(
        toX(STATE.p1.x), toY(STATE.p1.y),
        toX(STATE.p2.x), toY(STATE.p2.y),
        toX(1), toY(1)
      );
      bCtx.stroke();

      // Handles
      function drawPt(pt, col) {
        bCtx.beginPath();
        bCtx.arc(toX(pt.x), toY(pt.y), 6, 0, Math.PI * 2);
        bCtx.fillStyle = col;
        bCtx.fill();
        bCtx.lineWidth = 2;
        bCtx.strokeStyle = '#ffffff';
        bCtx.stroke();
      }
      drawPt(STATE.p1, '#818cf8');
      drawPt(STATE.p2, '#06b6d4');

      // Update text
      const bezierStr = `cubic-bezier(${STATE.p1.x.toFixed(2)}, ${STATE.p1.y.toFixed(2)}, ${STATE.p2.x.toFixed(2)}, ${STATE.p2.y.toFixed(2)})`;
      document.getElementById('bezierParamString').innerText = bezierStr;
      document.getElementById('curveEquationLabel').innerText = bezierStr;

      // Draw Mini Thumbnail
      drawMiniCurve();
    }

    function drawMiniCurve() {
      const mCanvas = document.getElementById('miniCurveCanvas');
      if (!mCanvas) return;
      const mCtx = mCanvas.getContext('2d');
      const w = mCanvas.width;
      const h = mCanvas.height;
      mCtx.clearRect(0, 0, w, h);
      mCtx.strokeStyle = '#6366f1';
      mCtx.lineWidth = 2;
      mCtx.beginPath();
      mCtx.moveTo(4, h - 4);
      mCtx.bezierCurveTo(
        4 + STATE.p1.x * (w - 8), (h - 4) - STATE.p1.y * (h - 8),
        4 + STATE.p2.x * (w - 8), (h - 4) - STATE.p2.y * (h - 8),
        w - 4, 4
      );
      mCtx.stroke();
    }

    function applyPresetCurve(type) {
      if (type === 'easeOutExpo') {
        STATE.p1 = { x: 0.16, y: 1.0 };
        STATE.p2 = { x: 0.30, y: 1.0 };
      } else if (type === 'springOvershoot') {
        STATE.p1 = { x: 0.34, y: 1.56 };
        STATE.p2 = { x: 0.64, y: 1.0 };
      } else if (type === 'anticipate') {
        STATE.p1 = { x: 0.68, y: -0.55 };
        STATE.p2 = { x: 0.26, y: 1.55 };
      } else if (type === 'linear') {
        STATE.p1 = { x: 0.0, y: 0.0 };
        STATE.p2 = { x: 1.0, y: 1.0 };
      }
      drawBezierInspectors();
      updateGeneratedCode();
      playTone(740, 0.04);
      triggerActiveAnimationAction();
    }

    function updateCurveLabels() {
