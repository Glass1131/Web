  counter-set: num var(--num);
}
.counter-box::after {
  content: counter(num);
}`;
      } else {
        return `// JS requestAnimationFrame 부드러운 수치 전환 함수
function animateCounter(el, start, end, duration = ${s.duration}) {
  let startTime = null;
  const easeOutExpo = t => t === 1 ? 1 : 1 - Math.pow(2, -10 * t);

  function step(time) {
    if (!startTime) startTime = time;
    const progress = Math.min((time - startTime) / duration, 1);
    const val = start + (end - start) * easeOutExpo(progress);
    el.innerText = Math.round(val).toLocaleString();
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
// animateCounter(myElement, 1, 2);`;
      }
    }

