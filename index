    }

    // Bezier Drag Listeners
    bCanvas.addEventListener('mousedown', (e) => {
      const rect = bCanvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const pad = 40;
      const plotW = bCanvas.width - pad * 2;
      const plotH = bCanvas.height - pad * 2;
      const p1x = pad + STATE.p1.x * plotW;
      const p1y = pad + (1 - STATE.p1.y) * plotH;
      const p2x = pad + STATE.p2.x * plotW;
      const p2y = pad + (1 - STATE.p2.y) * plotH;

      if (Math.hypot(x - p1x, y - p1y) < 18) draggingHandle = 'p1';
      else if (Math.hypot(x - p2x, y - p2y) < 18) draggingHandle = 'p2';
    });

    window.addEventListener('mousemove', (e) => {
      if (!draggingHandle) return;
      const rect = bCanvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const pad = 40;
      const plotW = bCanvas.width - pad * 2;
      const plotH = bCanvas.height - pad * 2;

      const normX = Math.max(0, Math.min(1, (x - pad) / plotW));
      const normY = parseFloat((1 - (y - pad) / plotH).toFixed(2));

      if (draggingHandle === 'p1') {
        STATE.p1.x = normX;
        STATE.p1.y = normY;
      } else if (draggingHandle === 'p2') {
        STATE.p2.x = normX;
        STATE.p2.y = normY;
      }
      drawBezierInspectors();
      updateGeneratedCode();
    });

    window.addEventListener('mouseup', () => { draggingHandle = null; });

